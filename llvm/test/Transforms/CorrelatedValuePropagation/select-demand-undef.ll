define i32 @loop_condition(i1 %c, i1 %exit, i32 %x) {
; CHECK-LABEL: define i32 @loop_condition(
; CHECK-SAME: i1 [[C:%.*]], i1 [[EXIT:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[X]], %[[ENTRY]] ], [ [[S:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[S]] = select i1 [[C]], i32 [[P]], i32 5
; CHECK-NEXT:    br i1 [[EXIT]], label %[[DONE:.*]], label %[[LOOP]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret i32 [[S]]
;
entry:
  br label %loop
loop:
  %p = phi i32 [ %x, %entry ], [ %s, %loop ]
  %s = select i1 %c, i32 %p, i32 5
  br i1 %exit, label %done, label %loop
done:
  ret i32 %s
}

