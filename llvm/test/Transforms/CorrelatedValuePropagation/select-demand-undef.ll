  %r = icmp ult i32 %s, 8
  ret i1 %r
}

; Keep the original proof-before-constraints behavior for complex conditions.
define i64 @shared_boolean_condition(i32 %x) {
; CHECK-LABEL: define range(i64 -2147483648, 2147483648) i64 @shared_boolean_condition(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    [[LO:%.*]] = icmp sgt i32 [[X]], 1
; CHECK-NEXT:    [[HI:%.*]] = icmp slt i32 [[X]], 100
; CHECK-NEXT:    [[C:%.*]] = and i1 [[LO]], [[HI]]
; CHECK-NEXT:    [[D0:%.*]] = and i1 [[C]], [[C]]
; CHECK-NEXT:    [[D1:%.*]] = and i1 [[D0]], [[D0]]
; CHECK-NEXT:    [[D2:%.*]] = and i1 [[D1]], [[D1]]
; CHECK-NEXT:    [[D3:%.*]] = and i1 [[D2]], [[D2]]
; CHECK-NEXT:    [[S:%.*]] = select i1 [[D3]], i32 [[X]], i32 0
; CHECK-NEXT:    [[R:%.*]] = sext i32 [[S]] to i64
; CHECK-NEXT:    ret i64 [[R]]
;
  %lo = icmp sgt i32 %x, 1
  %hi = icmp slt i32 %x, 100
  %c = and i1 %lo, %hi
  %d0 = and i1 %c, %c
  %d1 = and i1 %d0, %d0
  %d2 = and i1 %d1, %d1
  %d3 = and i1 %d2, %d2
  %s = select i1 %d3, i32 %x, i32 0
  %r = sext i32 %s to i64
  ret i64 %r
}
