; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=correlated-propagation -verify-each -S | FileCheck %s
;
; Conditions that cannot constrain the arms must not need an undef proof.
; Useful constraints must still respect undef and retain noundef/freeze facts.

define i1 @plain_condition(i1 %c) {
; CHECK-LABEL: define i1 @plain_condition(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:    [[S:%.*]] = select i1 [[C]], i32 5, i32 7
; CHECK-NEXT:    ret i1 true
;
  %s = select i1 %c, i32 5, i32 7
  %r = icmp ult i32 %s, 8
  ret i1 %r
}

define i1 @pointer_condition(i1 %c, ptr %p) {
; CHECK-LABEL: define i1 @pointer_condition(
; CHECK-SAME: i1 [[C:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:    [[S:%.*]] = select i1 [[C]], ptr [[P]], ptr null
; CHECK-NEXT:    [[R:%.*]] = icmp eq ptr [[S]], null
; CHECK-NEXT:    ret i1 [[R]]
;
  %s = select i1 %c, ptr %p, ptr null
  %r = icmp eq ptr %s, null
  ret i1 %r
}

